# ===== Supabase (Dashboard > Project Settings > API) =====
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STORAGE_BUCKET=product-images
EXPO_PUBLIC_STORE_BUCKET=store-avatars

# ===== Gemini (https://aistudio.google.com/apikey) =====
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash

# ===== Desarrollo =====
# true = login/registro simulado (sin backend) para trabajar cada rol en paralelo
EXPO_PUBLIC_USE_MOCK_AUTH=true
